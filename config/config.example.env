# Project-specific configuration for claude-config install
# Copy this to your project root as .claude-config.env and fill in values

# OpenProject
OP_BASE_URL=https://your-openproject-instance.example.com
OP_PROJECT_SLUG=your-project-slug
OP_PROJECT_ID=1

# GitHub
GITHUB_ORG_REPO=YourOrg/your-repo
BASE_BRANCH=main
