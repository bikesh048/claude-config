# Machine profile: Windows (WSL)
# Applied during --global install to configure platform-specific settings

# MCP server paths
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Statusline script (absolute path - WSL home)
STATUSLINE_SCRIPT="$HOME/.claude/statusline-command.sh"

# Platform tools (WSL uses GNU sed)
SED_INPLACE="sed -i"
