# Project configuration (set per project)
export OP_BASE_URL="https://your-openproject-instance.example.com"
export OP_PROJECT_SLUG="your-project-slug"
export OP_PROJECT_ID="1"
export GITHUB_ORG_REPO="YourOrg/your-repo"
export BASE_BRANCH="develop"

# API keys
export OPENPROJECT_API_KEY="your-api-key-here"

# Optional: Dashboard credentials (for projects with web dashboard)
# export DASHBOARD_URL="http://dashboard.test"
# export DASHBOARD_USER="your-email@example.com"
# export DASHBOARD_PASS="your-password"
